# Data is rebuildable from sources; never commit raw or normalized feeds
data/
# ...but the derived web publication is the app's committed data layer
!web/data/
!web/data/generated/
!web/data/generated/**
.cache/
*.duckdb
*.duckdb.wal

# Review-only transfer candidates (source-derived; never published)
reference/transfers.candidates.yaml
reference/loans.candidates.yaml

# Generated audit artefacts; keep the human-written reports tracked
reports/source-probes/
reports/ingest-*.json
reports/validation-*.json
reports/api-football-key-test-*.json
reports/unresolved/

# Web build
web/node_modules/
web/.next/
web/out/
web/.vercel/

# Secrets and local config
.env
.env.*
!.env.example

# OS/editor
.DS_Store
*.swp

# TypeScript incremental build
web/tsconfig.tsbuildinfo
