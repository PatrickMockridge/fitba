        "fixture_id",
        "season",
        "date",
        "kickoff",
        "kickoff_tz",
        "competition_id",
        "competition_name",
        "home_team_name",
        "away_team_name",
        "venue",
        "fixture_status",
        "state",
        "domestic",
        "international"
