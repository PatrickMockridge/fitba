          "type": "string"
        },
        "medium": {
          "enum": [
            "video",
            "audio"
          ],
          "title": "Medium",
          "type": "string"
        },
        "access": {
          "enum": [
            "live",
            "ppv",
            "replay"
          ],
          "title": "Access",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "medium",
        "access"
      ],
      "title": "BroadcastOutlet",
      "type": "object"
    },
    "BroadcastSource": {
      "additionalProperties": false,
      "properties": {
