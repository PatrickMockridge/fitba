          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "verified_at": {
          "title": "Verified At",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "confirmed",
            "reported",
            "curated",
            "unknown"
          ],
          "title": "Confidence",
          "type": "string"
